// Prisma schema for the Employee Work Management API.
// Phase 1: datasource/generator only. Models are added incrementally,
// starting with User/Organisation in Phase 2/3 — see docs/architecture.md
// for the full entity list and relationships.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Phase 2: Authentication ──────────────────────────────────────────────
// ── Phase 3: Organisations & tenant isolation ─────────────────────────────
// Every tenant-scoped row carries organisationId. Organisation/User soft
// delete via deletedAt (kept for referential history per architecture).
//
// Note: email is globally unique (not unique-per-org as the architecture
// eventually wants) to keep login simple while users are created via seed
// scripts. When Phase 4 introduces org-scoped user onboarding, relax this to
// @@unique([organisationId, email]).

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

model Organisation {
  id        String             @id @default(uuid())
  name      String
  timeZone  String             @default("Pacific/Auckland")
  country   String             @default("NZ")
  status    OrganisationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  users User[]
  employees Employee[]
  teams Team[]
  projects Project[]
  taskCategories TaskCategory[]
  tasks Task[]
  taskSchedules TaskSchedule[]
  timeEntries TimeEntry[]
  auditLogs AuditLog[]
  timesheets Timesheet[]
  attendanceRecords Attendance[]
  leaveRequests LeaveRequest[]
  notifications Notification[]

  @@map("organisations")
}

model User {
  id              String    @id @default(uuid())
  // Nullable so platform-level SUPER_ADMIN accounts exist without an org.
  // TenantGuard rejects org-scoped access when this is null.
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id])
  email           String    @unique
  passwordHash    String
  role            UserRole  @default(EMPLOYEE)
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  employee                Employee?
  taskComments            TaskComment[]
  taskAttachments         TaskAttachment[]
  editedTimeEntries       TimeEntry[]        @relation("TimeEntryEditedBy")
  auditLogs               AuditLog[]
   approvedTimesheets      Timesheet[]        @relation("TimesheetApprover")
   approvedLeaveRequests   LeaveRequest[]     @relation("LeaveApprover")
  notifications            Notification[]

  @@index([organisationId])
  @@map("users")
}

// ── Phase 4: Employees & Teams ───────────────────────────────────────────
// Every row carries organisationId (tenant-scoped by construction). The User
// link is 1:1 and nullable: a profile can exist for a user created later
// (link mode), and deleting a user must never cascade-delete the HR record —
// the employee row survives with userId set to null.
// Soft delete via deletedAt (employees are referential history for tasks,
// timesheets, etc. per architecture §B). Employment vs login state are kept
// separate on purpose: employmentStatus is the HR lifecycle, User.isActive is
// the login gate; disable/enable syncs both so a disabled employee cannot
// authenticate (Phase 4 acceptance test).
enum EmploymentStatus {
  ACTIVE
  DISABLED
}

model Employee {
  id               String           @id @default(uuid())
  organisationId   String
  organisation     Organisation     @relation(fields: [organisationId], references: [id])
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  phone            String?
  teamId           String?
  team             Team?            @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managerId        String?
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]       @relation("EmployeeManager")
  managedTeams     Team[]           @relation("TeamManager")
  timeZone         String           @default("Pacific/Auckland")
  workingHours     Json?
  emergencyContactName         String?  @map("emergency_contact_name")
  emergencyContactRelationship String?  @map("emergency_contact_relationship")
  emergencyContactPhone        String?  @map("emergency_contact_phone")
  emergencyContactEmail        String?  @map("emergency_contact_email")
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  managedProjects    Project[]        @relation("ProjectManager")
  createdTasks       Task[]           @relation("TaskCreator")
  taskAssignments    TaskAssignment[]
  assignedTasks      Task[]           @relation("TaskAssignee")
  assignedByTasks    TaskAssignment[] @relation("AssignmentAssigner")
  schedules          TaskSchedule[]
  timeEntries        TimeEntry[]
  timesheets         Timesheet[]
  attendanceRecords  Attendance[]
  leaveRequests      LeaveRequest[]

  @@index([organisationId])
  @@index([teamId])
  @@index([managerId])
  @@map("employees")
}

model Team {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  managerId      String?
  manager        Employee?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members        Employee[]   @relation("TeamMembers")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("teams")
}

// ── Phase 5: Projects ────────────────────────────────────────────────────
// Tenant-scoped like everything else. projectManagerId points at an Employee
// (not a User) so the HR record survives login changes. Status transitions
// are validated in the service (PLANNED → ACTIVE → COMPLETED, etc.).
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id               String        @id @default(uuid())
  organisationId   String
  organisation     Organisation  @relation(fields: [organisationId], references: [id])
  name             String
  description      String?
  customer         String?
  startDate        DateTime?     @db.Date
  endDate          DateTime?     @db.Date
  status           ProjectStatus @default(PLANNED)
  budgetHours      Float?
  budgetAmount     Decimal?      @db.Decimal(12, 2)
  projectManagerId String?
  projectManager   Employee?     @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  tasks Task[]
  timeEntries TimeEntry[]

  @@index([organisationId])
  @@index([projectManagerId])
  @@map("projects")
}

// ── Phase 6: Tasks ───────────────────────────────────────────────────────
// Single-assignee via Task.assigneeId (the hot path); TaskAssignment rows are
// the auditable assignment history (who assigned whom, when). current=true
// marks the live assignment; reassigning flips the old row to false.
// Status moves only through the service transition map — terminal states
// (COMPLETED/CANCELLED) never leave, which the critical Phase 6 test pins.
// Attachments are metadata-only in MVP (Phase 13 wires real object storage);
// comments are append-only (no edit/delete endpoints by design).
enum TaskStatus {
  NOT_STARTED
  SCHEDULED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  BLOCKED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model TaskCategory {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks Task[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("task_categories")
}

model Task {
  id               String       @id @default(uuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id])
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id])
  categoryId       String?
  category         TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  priority         TaskPriority @default(NORMAL)
  status           TaskStatus   @default(NOT_STARTED)
  estimatedMinutes Int?
  dueDate          DateTime?
  assigneeId       String?
  assignee         Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        Employee     @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  assignments TaskAssignment[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  schedules   TaskSchedule[]
  timeEntries TimeEntry[]

  @@index([organisationId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ── Phase 7: Scheduling ──────────────────────────────────────────────────
// A booked block of work: an employee works a task between two instants.
// Timestamps are UTC (per architecture decision 6 — the web/client converts
// to the employee's IANA timeZone for display). Overlaps for the same
// employee are *warned, not blocked* (architecture decision 4): the API
// returns an `overlaps` flag + `conflictIds` instead of rejecting.
model TaskSchedule {
  id             String   @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  scheduledStart DateTime
  scheduledEnd   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId])
  @@index([employeeId])
  @@index([scheduledStart, scheduledEnd])
  @@map("task_schedules")
}

// ── Phase 8: Time Tracking ─────────────────────────────────────────────────
// Timer model: ONE row per start; pause/resume bump pausedSeconds and move
// pauseStartedAt in/out. stop stamps endTime and recomputes durationSeconds.
// A partial unique index (@@unique on [organisationId, employeeId, status]
// can't be partial in Prisma) is enforced in the service instead: only one
// RUNNING or PAUSED entry may exist per employee — starting a second timer is
// a 409 (the Phase 8 critical test). Manual entries are COMPLETED at birth
// with a TIMER-free source and no endTime ambiguity (they always carry one).
enum TimeEntryStatus {
  RUNNING
  PAUSED
  COMPLETED
}

enum TimeEntrySource {
  TIMER
  MANUAL
  IMPORTED
}

model TimeEntry {
  id             String          @id @default(uuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId      String? // denormalised from the task at write time for reporting speed
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         TimeEntryStatus @default(RUNNING)
  source         TimeEntrySource @default(TIMER)
  startTime      DateTime
  endTime        DateTime?
  pausedSeconds  Int             @default(0)
  pauseStartedAt DateTime?
  durationSeconds Int?
  notes          String?
  editedById     String? // User who last audited-edited this entry
  editedBy       User?           @relation("TimeEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  auditLogs AuditLog[]

  @@index([organisationId])
  @@index([employeeId])
  @@index([taskId])
  @@map("time_entries")
}

// Audit trail for time-entry edits. Old/new JSON snapshots plus an optional
// human reason (required when a manager edits someone else's entry) so an
// approved-timesheet correction is always explainable.
model AuditLog {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String? // actor; null for system-generated rows
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String // e.g. "time_entry.update"
  entityType     String // e.g. "TimeEntry"
  entityId       String
  oldValueJson   Json?
  newValueJson   Json?
  timeEntryId    String?
  timeEntry      TimeEntry?   @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organisationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── Phase 9: Timesheets ──────────────────────────────────────────────────
// A weekly timesheet aggregating time entries for an employee. Once approved,
// the timesheet is immutable — corrections create a new version (the critical
// Phase 9 test). The status lifecycle is draft → submitted → approved/rejected.
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Timesheet {
  id             String        @id @default(uuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart    DateTime // Monday 00:00 UTC of the week
  periodEnd      DateTime // Sunday 23:59 UTC of the week
  status         TimesheetStatus @default(DRAFT)
  totalMinutes   Int           @default(0) // aggregated from time entries
  approvedById   String?
  approvedBy     User?         @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  rejectionReason String?
  version        Int           @default(1) // increments on correction
  parentTimesheetId String? // links correction to original
  parentTimesheet  Timesheet?  @relation("TimesheetCorrection", fields: [parentTimesheetId], references: [id], onDelete: SetNull)
  corrections     Timesheet[]  @relation("TimesheetCorrection")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organisationId, employeeId, periodStart, version])
  @@index([organisationId])
  @@index([employeeId])
  @@index([status])
  @@map("timesheets")
}

// ── Phase 9: Attendance ──────────────────────────────────────────────────
// Clock in/out records for daily attendance tracking. Break minutes are
// subtracted from the total duration. isLate/isEarlyDeparture are derived
// at write time against the employee's expected schedule.
model Attendance {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn        DateTime
  clockOut       DateTime?
  breakMinutes   Int          @default(0)
  isLate         Boolean      @default(false)
  isEarlyDeparture Boolean    @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
  @@index([employeeId])
  @@index([clockIn])
  @@map("attendance")
}

// ── Phase 9: Leave ───────────────────────────────────────────────────────
// Leave requests with approval workflow. Types: annual, sick, other.
// Status: pending → approved/rejected.
enum LeaveType {
  ANNUAL
  SICK
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           LeaveType    @default(ANNUAL)
  startDate      DateTime
  endDate        DateTime
  reason         String?
  status         LeaveStatus  @default(PENDING)
  approvedById   String?
  approvedBy     User?        @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

enum NotificationType {
  TASK_ASSIGNED
  TIMESHEET_APPROVED
  TIMESHEET_REJECTED
}

model Notification {
  id             String           @id @default(uuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  payloadJson    Json
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  readAt         DateTime?

  @@index([organisationId, userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model TaskAssignment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  assignedById String
  assignedBy   Employee @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())
  current      Boolean  @default(true)

  @@index([taskId])
  @@index([employeeId])
  @@map("task_assignments")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storageKey   String
  fileName     String
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// Refresh tokens are stored hashed (never plaintext) so a DB read alone
// can't be used to impersonate a user. Revocation is explicit via
// revokedAt, which supports logout and "reset password invalidates all
// sessions" without needing to delete rows (keeps an audit trail).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}
